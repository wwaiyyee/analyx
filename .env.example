# LLM
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANALYX_LLM_MODEL=gemini-2.5-flash
ANALYX_LLM_PROVIDER=gemini

# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ONCHAIN_OFFLINE_MODE=false
ONCHAIN_MAX_SIGNATURES=1000

# Backend
DATABASE_URL=sqlite:///./data/analyx.db
DATA_DIR=./data
JWT_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:3000
PRIVACY_MIN_GROUP=10

# Budgets (per request)
BUDGET_LOOKUP_TOOL_CALLS=4
BUDGET_ANALYSIS_TOOL_CALLS=10
BUDGET_INVESTIGATION_TOOL_CALLS=25
BUDGET_MAX_OUTPUT_TOKENS=4000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_PHANTOM_APP_ID=

# Feature flags (P1)
FEATURE_TEE=false
FEATURE_X402=false
FEATURE_PDF=false
